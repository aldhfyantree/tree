rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.phone_number in ['+966552806075', '+16505553434']; }
    match /persons/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /profiles/{uid} {
      allow create, read, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }
    match /changeRequests/{id} {
      allow create: if signedIn() && request.resource.data.submittedBy == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.submittedBy == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
